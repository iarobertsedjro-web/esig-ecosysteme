# =========================================================================
#  .env.example — Variables d'environnement (modèle SANS valeurs sensibles)
#  Copier en « .env » sur le serveur concerné. Ne JAMAIS committer le .env.
# =========================================================================

# --- ESIG Success Assistant (API serveur — assistant/serveur-exemple.js) ---
# Clé du fournisseur de modèle (Claude API). Reste exclusivement côté serveur.
CLE_API_MODELE=

# Port d'écoute de l'API de l'assistant
PORT=8787

# Origine autorisée pour les appels du widget (CORS)
ORIGINE_AUTORISEE=https://esig.tg

# --- Mesure d'audience ---
# L'identifiant GA4 n'est pas un secret : il se renseigne dans config-site.js
# (ANALYTICS_CONFIG.ga4_id) et non ici.

# --- Formulaires ---
# Les identifiants Formspree ne sont pas des secrets (ils sont visibles côté
# client par conception). En cas de migration vers une API de formulaires
# maison, placer ici ses éventuels jetons :
# CLE_API_FORMULAIRES=
